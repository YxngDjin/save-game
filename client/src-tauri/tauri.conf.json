{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaveGame",
  "version": "0.2.0",
  "identifier": "com.yxngdjin.savegames",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "visible": false,
        "title": "SaveGame",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 550
      },
      {
        "label": "tray",
        "title": "SaveGame",
        "width": 360,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
